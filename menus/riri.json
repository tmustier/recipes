  "stations": [
    {
      "key": "beef", "name": "Beef",
      "jobs": [
        { "when": "First, once shopping's in", "text": "Season and sear the fillet, coat it with horseradish mustard, then fridge it uncovered.", "recipe": "beef-wellington" },
        { "when": "Mid-afternoon", "text": "With Duxelles: roll the fillet up in the prosciutto layer, then chill.", "recipe": "beef-wellington" },
        { "when": "About 1¼ hr before eating", "text": "Egg-wash, score and bake to 43–49 °C at the centre.", "recipe": "beef-wellington" },
        { "when": "At the end", "text": "Rest 10 min, then carve with the serrated knife. Chives and salt on the cut faces.", "recipe": "beef-wellington" }
      ]
    },
    {
      "key": "duxelles", "name": "Duxelles and pastry",
      "jobs": [
        { "when": "First, once shopping's in", "text": "Duxelles and foie gras, then chill.", "recipe": "beef-wellington" },
        { "when": "Mid-afternoon", "text": "Phyllo, prosciutto and duxelles layer; with Beef, roll the fillet. Roll out the pastry and wrap. Chill at least 30 min.", "recipe": "beef-wellington" },
        { "when": "Then", "text": "Mince the chives, and help Sides." }
      ]
    },
    {
      "key": "sides", "name": "Sides and sauce",
      "jobs": [
        { "when": "Mid-afternoon", "text": "Slice the shallots and garlic. Reduce the stock and wine, then turn the heat off.", "recipe": "shallot-jus" },
        { "when": "Mid-afternoon", "text": "Blanch the beans and chill them in iced water. Dry, then set aside.", "recipe": "haricots-verts-amandine" },
        { "when": "About 1 hr before eating", "text": "Potatoes on. Rice and finish the purée, then keep it warm.", "recipe": "pommes-puree" },
        { "when": "While the beef rests", "text": "Finish the jus. Toast the almonds and toss the beans.", "recipe": "haricots-verts-amandine" }
      ]
    },
    {
      "key": "dessert", "name": "Dessert, apéro and table",
      "jobs": [
        { "when": "First, before the oven gets busy", "text": "Bake both gâteaux, then cool and chill for 3 hr+.", "recipe": "tokyo-gateau" },
        { "when": "Before 7:30pm", "text": "Lay the table. Apéro board out as guests arrive." },
        { "when": "At dessert", "text": "Unmould and slice the gâteaux. Candles on the birthday cake.", "recipe": "tokyo-gateau" }
      ]
    }
